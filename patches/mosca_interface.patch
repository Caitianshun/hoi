diff --git a/lib_moca/pixel_geometry.py b/lib_moca/pixel_geometry.py
new file mode 100644
index 0000000..9ca02ab
--- /dev/null
+++ b/lib_moca/pixel_geometry.py
@@ -0,0 +1,49 @@
+"""Geometry interface v2: integer pixel centres and short-side normalized units.
+
+The normalized domain is q=(2*pixel-[W,H])/min(H,W). It is not a
+grid_sample domain and does not add a half pixel. K uses the same integer
+pixel centres. This affine convention preserves the old loss unit scale.
+"""
+import numpy as np
+import torch
+
+GEOMETRY_INTERFACE_VERSION = 2
+
+
+def _wh_like(value, H, W):
+    return torch.stack([torch.as_tensor(W, device=value.device, dtype=value.dtype),
+                        torch.as_tensor(H, device=value.device, dtype=value.dtype)])
+
+
+def pixel_to_homo(pixel, H, W):
+    if not torch.is_floating_point(pixel):
+        pixel = pixel.float()
+    wh = _wh_like(pixel, H, W)
+    return (2.0 * pixel - wh) / wh.min()
+
+
+def homo_to_pixel(homo, H, W):
+    wh = _wh_like(homo, H, W)
+    return (homo * wh.min() + wh) / 2.0
+
+
+def get_homo_coordinate_map(H, W):
+    H, W = int(H), int(W)
+    if H < 1 or W < 1:
+        raise ValueError('Image dimensions must be positive')
+    u, v = np.meshgrid(np.arange(W, dtype=np.float64), np.arange(H, dtype=np.float64))
+    return (2.0 * np.stack([u, v], axis=-1) - np.array([W, H])) / min(H, W)
+
+
+def normalized_principal(cams, like, H=None, W=None):
+    ratio = torch.as_tensor(cams.cxcy_ratio, device=like.device, dtype=like.dtype)
+    if H is None and W is None:
+        H, W = getattr(cams, 'default_H', None), getattr(cams, 'default_W', None)
+    if H is None or W is None:
+        # The uncalibrated FOV search helpers explicitly assume a centred K.
+        # Their zero normalized principal is valid at every aspect ratio.
+        if bool(torch.all(ratio == 0.5)):
+            return ratio * 0.0
+        raise ValueError('Non-centred principal point requires image H and W')
+    wh = _wh_like(like, H, W)
+    return (2.0 * ratio - 1.0) * wh / wh.min()
